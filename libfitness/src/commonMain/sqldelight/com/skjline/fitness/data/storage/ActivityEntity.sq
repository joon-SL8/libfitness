CREATE TABLE ActivityEntity (
    id INTEGER NOT NULL,
    session INTEGER NOT NULL,
    timestamp INTEGER NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    start TEXT NOT NULL,
    duration INTEGER NOT NULL,
    power INTEGER,
    heart INTEGER,
    speed INTEGER,
    cadence INTEGER,
    PRIMARY KEY (id, session, timestamp)
);

insert:
INSERT OR REPLACE INTO ActivityEntity(id, session, timestamp, name, description, start, duration, power, heart, speed, cadence)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getMaxId:
SELECT id FROM ActivityEntity ORDER BY id DESC LIMIT 1;

getMaxIdForSession:
SELECT id FROM ActivityEntity WHERE session = :sessionId ORDER BY id DESC LIMIT 1;

getAll:
SELECT * FROM ActivityEntity;

getAllForSession:
SELECT * FROM ActivityEntity WHERE session = :sessionId;

delete:
DELETE FROM ActivityEntity
WHERE session IS :sessionId;
