CREATE TABLE ActivitySession (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT,
    sessionDate INTEGER NOT NULL,
    duration INTEGER NOT NULL,
    mrcFilename TEXT NOT NULL,
    mrcFilepath TEXT NOT NULL,
    sessionFilename TEXT NOT NULL,
    sessionPublished INTEGER
);

insert:
INSERT OR REPLACE INTO ActivitySession(id, name, description, sessionDate, duration, mrcFilename, mrcFilepath, sessionFilename, sessionPublished)
VALUES (?,?,?,?,?,?,?,?,?);

updateSessionPublish:
UPDATE ActivitySession
 SET sessionPublished = :sessionPublishedOn
WHERE id = :sessionId;

updateSessionPublishFilename:
UPDATE ActivitySession
 SET sessionFilename = :sessionFilename
WHERE id = :sessionId;

getAll:
SELECT * FROM ActivitySession;

getMaxId:
SELECT id FROM ActivitySession ORDER BY id DESC LIMIT 1;

getBySessionId:
SELECT * FROM ActivitySession WHERE id = :sessionId;

getByName:
SELECT * FROM ActivitySession WHERE name = :sessionName;

getByDateRange:
SELECT * FROM ActivitySession WHERE sessionDate > :dateFrom AND sessionDate < :dateTo;

delete:
DELETE FROM ActivitySession
WHERE id IS :id;

deleteAll:
DELETE FROM ActivitySession;
