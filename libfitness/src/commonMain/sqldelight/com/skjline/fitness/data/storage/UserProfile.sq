CREATE TABLE UserProfileEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    data TEXT NOT NULL,
    updated INTEGER NOT NULL
);

insert:
INSERT OR REPLACE INTO UserProfileEntity(id, name, data, updated)
VALUES(?, ?, ?, ?);

getCount:
SELECT COUNT(*) FROM UserProfileEntity;

getAll:
SELECT * FROM UserProfileEntity;

getForKey:
SELECT * FROM UserProfileEntity
WHERE name =:name;

updateData:
UPDATE UserProfileEntity
SET data =:data
WHERE id =:id;

delete:
DELETE FROM UserProfileEntity
WHERE id =:id;